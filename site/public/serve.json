{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    { "source": "**/*.@(js|css|svg|woff2|jpg|png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "downloads/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "**", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
    ] }
  ]
}
