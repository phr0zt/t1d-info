---
import "../styles/global.css";
import { T, TOPICS, TOPIC_ORDER, type Lang, type TopicKey } from "../lib/i18n";
import { topicUrl, staticUrl, emergencyLink } from "../lib/pages";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  altUrl?: string; // same page in the other language
  topic?: TopicKey;
  noindex?: boolean;
}
const { lang, title, description, altUrl, topic, noindex } = Astro.props;
const t = T[lang];
const other: Lang = lang === "en" ? "fr" : "en";
const switchHref = altUrl ?? `/${other}/`;
const fullTitle = title === t.siteName ? `${t.siteName} · ${t.alias}` : `${title} · ${t.alias}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const hypo = await emergencyLink(lang, ["hypo", "low"]);
const dka = await emergencyLink(lang, ["dka"]);
const sick = await emergencyLink(lang, ["sick"]);
---
<!doctype html>
<html lang={lang === "fr" ? "fr-CA" : "en-CA"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {altUrl && <link rel="alternate" hreflang={other === "fr" ? "fr-CA" : "en-CA"} href={new URL(altUrl, Astro.site)} />}
    <link rel="alternate" hreflang={lang === "fr" ? "fr-CA" : "en-CA"} href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content={lang === "fr" ? "fr_CA" : "en_CA"} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Outfit:wght@500;600&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={`/${lang}/`} aria-label={`${t.siteName} — ${t.home}`}>
          <span class="lib">{t.library}</span>
          <span class="bar" aria-hidden="true"></span>
          <span class="alias">KRKT<b>:</b>T1DE</span>
        </a>
        <nav class="header-nav" aria-label={t.menu}>
          <a class="pill" href={staticUrl(lang, "search")}>{t.search}</a>
          <a class="pill" href={staticUrl(lang, "downloads")}>{t.downloads}</a>
          <a class="pill" href={switchHref} hreflang={other} lang={other}>{t.switchLang}</a>
        </nav>
      </div>
    </header>
    <div class="emergency-strip" role="note">
      <div class="wrap">
        <strong>{t.emergencyTitle}</strong>
        <span>{t.emergencyText}</span>
        <a href={hypo}>{t.emergencyLinks.hypo}</a>
        <a href={dka}>{t.emergencyLinks.dka}</a>
        <a href={sick}>{t.emergencyLinks.sick}</a>
      </div>
    </div>
    <nav class="topic-nav" aria-label={t.topics}>
      <div class="wrap">
        <ul>
          {TOPIC_ORDER.map((k) => (
            <li><a href={topicUrl(lang, k)} aria-current={k === topic ? "page" : undefined}>{TOPICS[k].label[lang]}</a></li>
          ))}
        </ul>
      </div>
    </nav>
    <main id="content">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap cols">
        <div>
          <div class="alias">KRKT:T1DE</div>
          <p>{t.siteName}, {t.fromLibrary}.</p>
          <p>{t.footerNote}</p>
        </div>
        <div>
          <p>{t.disclaimer}</p>
          <p><a href={staticUrl(lang, "about")}>{t.about}</a> · <a href={staticUrl(lang, "sources")}>{t.allSources}</a> · <a href={staticUrl(lang, "downloads")}>{t.downloads}</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
